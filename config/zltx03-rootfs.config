# ZLT X03 / SXL-D01 (UDX710 4h10) — 方案 B: 只换根文件系统, 保原厂 4.14 内核
# 不依赖任何 kernel module，避免与 4.14 ABI 冲突
CONFIG_TARGET_sprd=y
CONFIG_TARGET_sprd_udx710=y
CONFIG_TARGET_sprd_udx710_DEVICE_sy108=y
CONFIG_TARGET_DEVICE_sprd_udx710_DEVICE_sy108=y
CONFIG_DEVEL=y

# 只产出 rootfs 归档，不产出 squashfs/sysupgrade 镜像
CONFIG_TARGET_ROOTFS_TARGZ=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

CONFIG_BUILD_LOG=y

# ---- 用户态核心 ----
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-theme-outline=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---- 工具 ----
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_flock=y

# ---- 关键: 关掉所有依赖内核模块的包 (原厂内核 4.14 无法加载 7.3 的 .ko) ----
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_firewall is not set
# CONFIG_PACKAGE_nftables is not set
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_dnsmasq-full is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_kmod-ppp is not set
# CONFIG_PACKAGE_udx-runtime is not set
# CONFIG_PACKAGE_udx-cellular is not set
# CONFIG_PACKAGE_udx-cpnv is not set
# CONFIG_PACKAGE_udx-device is not set
# CONFIG_PACKAGE_udx-usb is not set
# CONFIG_PACKAGE_udx-upgrade is not set
# CONFIG_PACKAGE_luci-app-udx is not set
# CONFIG_PACKAGE_luci-app-sy108-system is not set
# CONFIG_SY108_RECOVERY is not set

# ---- busybox 增强 ----
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_LOGIN=y
CONFIG_BUSYBOX_CONFIG_CHPASSWD=y
CONFIG_BUSYBOX_CONFIG_TASKSET=y
CONFIG_BUSYBOX_CONFIG_FLOAT_DURATION=y
